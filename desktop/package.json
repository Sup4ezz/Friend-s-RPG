{
  "name": "lorgus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LORGUS desktop client for Windows",
  "main": "main.cjs",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.cjs",
    "start": "npm run build:renderer && electron .",
    "dist:win": "npm run build:renderer && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11"
  },
  "build": {
    "appId": "world.lorgus.desktop",
    "productName": "ЛОРГУС",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json",
      "node_modules/@supabase/**/*",
      "node_modules/@supabase-js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1"
  }
}
